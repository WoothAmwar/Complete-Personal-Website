# Copy this file to .env.local (repo root). Loaded by server/YoutubeData/youtube_database.py
# via python-dotenv (it walks up from server/YoutubeData to the repo root to find it).

# MongoDB connection string.
# For local dev, run `docker compose up -d` from server/ (see server/docker-compose.yml) and use:
MONGODB_URI=mongodb://localhost:27017/personal-website-dev
# For production/Atlas, use your Atlas connection string instead, e.g.:
# MONGODB_URI=mongodb+srv://vercel-admin-user-6611a64f96d22001f16e1bc5:9Okb88txPGphLnnG@prod-yt.10vdjom.mongodb.net/myFirstDatabase?retryWrites=true&w=majority
# Set to 1 to make server/YoutubeData/youtube.py return fixture data (from the automatic*.json
# files already checked into server/YoutubeData/) instead of calling the live YouTube Data API.
# Useful offline or if you don't have a per-user YouTube API key set up yet.
USE_MOCK_YOUTUBE=0

# Note: the YouTube Data API key itself is NOT an env var — it's stored per-user in MongoDB via
# the /users/apiKey endpoint (see server/YoutubeData/youtube_database.py: get_user_api/add_user_api).
