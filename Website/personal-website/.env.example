# Copy this file to .env.local (same folder) and pick ONE of the options below.
# Next.js only reads NEXT_PUBLIC_API_URL from .env.local, not from this file.

# Option A — Frontend-only mock backend (recommended for offline / frontend-only work).
# No Python, MongoDB, or YouTube API key needed. Start it with `npm run mock` (see mocks/server.js),
# or just use `npm run dev:mock` to run Next.js and the mock backend together.
# NEXT_PUBLIC_API_URL=http://localhost:27017/api

# Option B — Real Flask backend (see ../../server), running locally.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional — skip the Google OAuth popup and sign in as a fixture "dev-user-1" account.
# Only affects LoginButton in development; safe to leave off.
NEXT_PUBLIC_USE_MOCK_AUTH=1
